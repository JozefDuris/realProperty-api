@page "/properties"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Real Properties</PageTitle>

<h1>Real Properties</h1>

@if (isLoading)
{
    <p><em>Loading properties...</em></p>
}
else if (errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="RefreshProperties">
            Try Again
        </button>
    </div>
}
else if (properties?.Any() == true)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Address</th>
                    <th>Property Type</th>
                    <th>Area (m²)</th>
                    <th>Rooms</th>
                    <th>Price</th>
                    <th>Version</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in properties)
                {
                    var latestVersion = property.GetLatestVersion();
                    if (latestVersion != null)
                    {
                        <tr>
                            <td>@property.Id</td>
                            <td>@latestVersion.Address</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @latestVersion.PropertyType
                                </span>
                            </td>
                            <td>@latestVersion.Area</td>
                            <td>@latestVersion.Rooms</td>
                            <td>@latestVersion.Price.ToString("C")</td>
                            <td>@latestVersion.VersionNumber</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" 
                                        @onclick="() => ViewDetails(property.Id)">
                                    View Details
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        No properties found.
    </div>
}

<div class="mt-3">
    <button class="btn btn-secondary" @onclick="RefreshProperties" disabled="@isLoading">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Loading...</span>
        }
        else
        {
            <span class="bi bi-arrow-clockwise"></span>
            <span>Refresh</span>
        }
    </button>
</div>

@code {
    private List<RealProperty>? properties;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProperties();
    }

    private async Task LoadProperties()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var httpClient = HttpClientFactory.CreateClient("WebApi");
            
            // Note: In a real application, you would handle authentication here
            // For now, this will likely fail due to the [Authorize] attribute on the controller
            var response = await httpClient.GetAsync("real-properties");
            
            if (response.IsSuccessStatusCode)
            {
                properties = await response.Content.ReadFromJsonAsync<List<RealProperty>>();
            }
            else
            {
                errorMessage = $"Failed to load properties. Status: {response.StatusCode}";
                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage += " - Authentication required. Please ensure the API is configured for anonymous access or implement authentication.";
                }
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Connection error: {ex.Message}. Please ensure the API is running.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading properties: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewDetails(int propertyId)
    {
        NavigationManager.NavigateTo($"/properties/{propertyId}");
    }

    private async Task RefreshProperties()
    {
        await LoadProperties();
        StateHasChanged();
    }
}